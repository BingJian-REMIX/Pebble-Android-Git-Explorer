<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pebble.EditorPage"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <Grid RowDefinitions="*,Auto">

        <Editor x:Name="Body"
                Grid.Row="0"
                Margin="12,8"
                FontSize="13"
                FontFamily="{OnPlatform WinUI=Consolas, Android=monospace}"
                TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                BackgroundColor="Transparent"
                AutoSize="Disabled" />

        <Border Grid.Row="1"
                Margin="12,4,12,14"
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Button Text="保存"
                    Clicked="OnSaveClicked"
                    HeightRequest="44"
                    CornerRadius="12"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C5CFF" Offset="0.0" />
                        <GradientStop Color="#3B82F6" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Border>
    </Grid>
</ContentPage>
