<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pebble.EditorPage"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <!-- 操作栏不参与行布局，直接浮在底部：
         Windows 上 WebView2 的高度测量会返回无限值，会把 Auto 行挤出可视区。 -->
    <Grid>

        <Grid RowDefinitions="Auto,*">

            <!-- 顶部：体积 + 位置（文件名已由导航栏标题承担，这里不再重复） -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Padding="{OnPlatform Default='14,10,16,10', Android='16,10,16,10'}"
                  ColumnSpacing="12">

                <Label x:Name="MetaLabel"
                       Grid.Column="0"
                       FontSize="12"
                       VerticalOptions="Center"
                       LineBreakMode="MiddleTruncation"
                       TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />

                <Border Grid.Column="1"
                        IsVisible="False"
                        x:Name="ReadOnlyBadge"
                        Padding="8,3"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#3F2D0A}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="7" />
                    </Border.StrokeShape>
                    <Label Text="只读" FontSize="10" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FBBF24}" />
                </Border>

                <!-- 分隔线：标题区与代码内容之间留出清晰边界，避免无缝贴连 -->
                <BoxView Grid.ColumnSpan="2"
                         HeightRequest="1"
                         VerticalOptions="End"
                         BackgroundColor="{AppThemeBinding Light=#E3E8F0, Dark=#1E2434}" />
            </Grid>

            <!-- 给底部操作栏留出空间 -->
            <WebView Grid.Row="1"
                     x:Name="View"
                     Margin="0,0,0,86"
                     BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}" />

            <!-- 缩放控制（浮在编辑器右上角）：捏合或按钮均可缩放 -->
            <Border Grid.Row="1"
                    VerticalOptions="Start"
                    HorizontalOptions="End"
                    ZIndex="6"
                    Margin="0,8,12,0"
                    Padding="4"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                    Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="2">
                    <Button x:Name="ZoomOutButton"
                            Text="−"
                            FontSize="18"
                            WidthRequest="36" HeightRequest="36"
                            Padding="0"
                            CornerRadius="10"
                            BorderWidth="0"
                            Clicked="OnZoomOut"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#5B4BE0, Dark=#C4B5FD}" />
                    <Label x:Name="ZoomLabel"
                           Text="100%"
                           FontSize="12"
                           VerticalOptions="Center"
                           WidthRequest="46"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA1B2}" />
                    <Button x:Name="ZoomInButton"
                            Text="+"
                            FontSize="18"
                            WidthRequest="36" HeightRequest="36"
                            Padding="0"
                            CornerRadius="10"
                            BorderWidth="0"
                            Clicked="OnZoomIn"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#5B4BE0, Dark=#C4B5FD}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 底部操作栏 -->
        <Border VerticalOptions="End"
                Margin="12,0,12,14"
                Padding="10"
                ZIndex="10"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                <Button x:Name="ToggleButton"
                        Grid.Column="0"
                        IsVisible="False"
                        Text="预览"
                        Clicked="OnToggleClicked"
                        HeightRequest="44"
                        CornerRadius="12"
                        Padding="16,0"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#5B4BE0, Dark=#C4B5FD}"
                        BackgroundColor="{AppThemeBinding Light=#EEF0FB, Dark=#1A1F33}"
                        BorderWidth="0" />

                <Label x:Name="StatusLabel"
                       Grid.Column="1"
                       FontSize="11"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Text="保存"
                        Clicked="OnSaveClicked"
                        HeightRequest="44"
                        CornerRadius="12"
                        Padding="24,0"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C5CFF" Offset="0.0" />
                            <GradientStop Color="#3B82F6" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
