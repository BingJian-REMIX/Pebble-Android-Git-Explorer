<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Pebble.Models"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:Class="Pebble.ImagePreviewPage"
             BackgroundColor="#000000">

    <Grid>

        <!-- 图片轮播：左右滑动切换 -->
        <CarouselView x:Name="Carousel"
                      Loop="False"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      PositionChanged="OnPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:FileItem">
                    <Image x:Name="Pic"
                           Aspect="AspectFit"
                           Source="{Binding FullPath}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill">
                        <Image.GestureRecognizers>
                            <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                            <TapGestureRecognizer Tapped="OnDoubleTapped" NumberOfTapsRequired="2" />
                        </Image.GestureRecognizers>
                    </Image>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- 顶部信息条 -->
        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Start"
              Padding="{OnPlatform Default='16,14,16,8', Android='16,42,16,8'}"
              ColumnSpacing="12"
              BackgroundColor="#66000000">

            <VerticalStackLayout Spacing="2">
                <Label x:Name="NameLabel"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       LineBreakMode="MiddleTruncation" />
                <Label x:Name="MetaLabel"
                       FontSize="11"
                       TextColor="#B4B8C4" />
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    WidthRequest="32" HeightRequest="32"
                    StrokeThickness="1"
                    Stroke="#4C5468"
                    BackgroundColor="#33161A26"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <Ellipse />
                </Border.StrokeShape>
                <Image Source="close_white" WidthRequest="14" HeightRequest="14"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Border>
        </Grid>

        <Label Text="左右滑动切换 · 双指缩放"
               FontSize="10"
               TextColor="#8B94A8"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,24" />
    </Grid>
</ContentPage>
