<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pebble.SettingsPage"
             Title="设置"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="20">

            <!-- GitHub Token -->
            <VerticalStackLayout Spacing="8">
                <Label Text="GitHub Token" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="用于 Clone / Push 私有仓库。保存在系统安全存储 (SecureStorage)。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1"
                        Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="TokenEntry"
                           IsPassword="True"
                           Placeholder="ghp_… 或留空清除"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent"
                           HeightRequest="46" />
                </Border>
                <Button Text="保存 Token" Clicked="OnSaveTokenClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

            <!-- 主题 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="主题" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Picker x:Name="ThemePicker" SelectedIndexChanged="OnThemeChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>跟随系统</x:String>
                            <x:String>浅色</x:String>
                            <x:String>深色</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <!-- 服务器端口 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Web 服务器端口" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10131C}"
                        Stroke="{AppThemeBinding Light=#DCE1EC, Dark=#1E2434}" StrokeThickness="1"
                        Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="PortEntry"
                           Keyboard="Numeric"
                           Placeholder="8080"
                           PlaceholderColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}"
                           TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}"
                           BackgroundColor="Transparent"
                           HeightRequest="46" />
                </Border>
                <Button Text="保存端口" Clicked="OnSavePortClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

            <!-- 清理回收站 -->
            <VerticalStackLayout Spacing="8">
                <Label Text="清理回收站" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label Text="删除本应用在沙盒回收站里的文件，释放空间。此操作不可撤销。"
                       FontSize="11" TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
                <Button Text="清理回收站" Clicked="OnClearTrashClicked" Style="{StaticResource CtxButton}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
