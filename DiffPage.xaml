<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pebble.DiffPage"
             BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="{OnPlatform Default='16,12,16,8', Android='16,40,16,8'}">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="TitleLabel" FontSize="14" FontAttributes="Bold"
                       LineBreakMode="MiddleTruncation"
                       TextColor="{AppThemeBinding Light=#14161F, Dark=#E9ECF5}" />
                <Label x:Name="MetaLabel" FontSize="11"
                       TextColor="{AppThemeBinding Light=#9AA1B2, Dark=#4C5468}" />
            </VerticalStackLayout>
        </Grid>

        <WebView Grid.Row="1"
                 x:Name="View"
                 BackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#07090F}" />
    </Grid>
</ContentPage>
